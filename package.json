{
  "name": "gem-quest",
  "version": "1.1.0",
  "private": true,
  "description": "Production-ready HTML5 arena survival game for CrazyGames.",
  "scripts": {
    "start": "node serve.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:architecture": "node scripts/architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run check && npm run typecheck && npm test && npm run build && npm run verify:dist"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
